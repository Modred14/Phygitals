# Neon (pooled for app, direct for migrations)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.neon.tech/db?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.neon.tech/db?sslmode=require"

# Branding (change freely; do not use a third party's trademark)
NEXT_PUBLIC_APP_NAME="Your Brand"

# Telegram
TELEGRAM_BOT_TOKEN="replace-me"            # server only
TELEGRAM_WEBHOOK_SECRET="random-16+chars-letters-digits-_-"   # openssl rand -hex 24
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"   # public https URL, no trailing slash
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME="YOUR_BOT_USERNAME"
TELEGRAM_INITDATA_MAX_AGE_SECONDS="3600"

# Sessions / admin
SESSION_SECRET="long-random-string"

# Solana (public values only; NO private keys here)
SOLANA_CLUSTER="mainnet-beta"
SOLANA_RPC_URL="https://api.mainnet-beta.solana.com"
SOLANA_DEPOSIT_TREASURY_ADDRESS="replace-me"
SOLANA_USDC_MINT="EPjFWdd5AuqkWA2oBfGC1UFJyvKkoWB6QYkvK3kD8Gde"

# Launch gates (must be set true deliberately after legal/funding review)
PAID_OPENINGS_ENABLED="false"
WITHDRAWALS_ENABLED="false"
REFERRAL_REWARDS_ENABLED="false"

# Cron/ops
WITHDRAWAL_FEE_CENTS="300"                   # platform processing fee (not a blockchain fee)
WITHDRAWAL_MIN_CENTS="1000"
WITHDRAWAL_MAX_CENTS="1000000"
ADMIN_ENCRYPTION_KEY="base64-of-32-random-bytes"   # openssl rand -base64 32 ; encrypts admins' 2FA secrets
